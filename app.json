{
  "expo": {
    "name": "Runstart",
    "slug": "runstart",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "runstart",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B1F3A",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "dk.caritas.runstart",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true,
        "NSLocationWhenInUseUsageDescription": "Used only for outdoor runs to measure distance, pace and speed. GPS is never used on the treadmill."
      },
      "appleTeamId": "VF9US8746B"
    },
    "android": {
      "package": "dk.caritas.runstart",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0B1F3A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ],
      "predictiveBackGestureEnabled": false
    },
    "locales": {
      "da": "./locales/da.json",
      "en": "./locales/en.json",
      "fr": "./locales/fr.json",
      "de": "./locales/de.json",
      "es": "./locales/es.json"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 280,
          "backgroundColor": "#0B1F3A",
          "resizeMode": "contain"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": true,
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Used only for outdoor runs to measure distance, pace and speed. GPS is never used on the treadmill.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false,
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": true,
          "motionUsagePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#0B1F3A",
          "enableRemoteNotifications": false,
          "enableBackgroundRemoteNotifications": false
        }
      ],
      "expo-sharing",
      "expo-localization",
      "expo-font",
      "expo-task-manager"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}